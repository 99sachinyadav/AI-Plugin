# ============================================================
# Contextly Backend — Production Environment Variables
# Copy these into your cloud provider's dashboard (Railway / Render / Fly.io)
# NEVER commit real keys to git
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# CORS — set to your deployed backend URL (or * for open)
CORS_ORIGIN=*

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/contextly?retryWrites=true&w=majority

# AI Provider to use: gemini | deepseek | openai
AI_PROVIDER=gemini

# API Keys (set only the one you use)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Models
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# Rate Limiting (increase in production if needed)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
MAX_CONTEXT_CHAR_LIMIT=12000
