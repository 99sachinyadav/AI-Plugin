# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration
# MongoDB connection URI (e.g. mongodb://localhost:27017/contextly or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/contextly

# AI Provider Configuration
# Options: 'gemini' | 'deepseek' | 'openai'
AI_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional Default Models (leave blank for defaults)
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# Security & Limits
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
MAX_CONTEXT_CHAR_LIMIT=12000
